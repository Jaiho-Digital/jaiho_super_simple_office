/* ==========================================================================
   Jaiho Super Simple Office — Handcrafted Desktop Style Sheet
   Aesthetic: Archival Paper & Obsidian Ink (Swiss Editorial / Tactile)
   ========================================================================== */

* {
    font-family: $font_family;
    font-size: $font_size_base;
    color: $text_primary;
    outline: none;
}

QMainWindow, QDialog {
    background-color: $bg_canvas;
}

QWidget {
    background-color: transparent;
    color: $text_primary;
}

/* --- Typography Roles --- */
QLabel[role="title"] {
    font-size: $font_size_lg;
    font-weight: 600;
    color: $text_primary;
}

QLabel[role="section-header"] {
    font-size: $font_size_md;
    font-weight: 600;
    color: $text_primary;
}

QLabel[role="muted"] {
    font-size: $font_size_sm;
    color: $text_secondary;
}

QLabel[role="caption"] {
    font-size: $font_size_xs;
    color: $text_muted;
}

QLabel[role="display-xl"] {
    font-family: $font_mono;
    font-size: 32px;
    font-weight: 600;
    color: $text_primary;
}

QLabel[role="display-lg"] {
    font-family: $font_mono;
    font-size: $font_size_xl;
    font-weight: 600;
    color: $text_primary;
}

QLabel[code="true"] {
    font-family: $font_mono;
}

/* --- Structural Surfaces & Depth Hierarchy --- */
QFrame[surface="card"] {
    background-color: $bg_surface;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
}

QFrame[surface="elevated"] {
    background-color: $bg_elevated;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
}

QFrame[surface="recessed"] {
    background-color: $bg_recessed;
    border: 1px solid $border_strong;
    border-radius: $radius_md;
}

QFrame[surface="sidebar"] {
    background-color: $bg_surface;
    border-right: 1px solid $border_subtle;
}

QFrame[surface="inspector"] {
    background-color: $bg_surface;
    border-left: 1px solid $border_subtle;
}

QFrame[surface="toolbar-strip"] {
    background-color: $bg_surface;
    border-bottom: 1px solid $border_subtle;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: $border_subtle;
}

/* --- Menu Bar & Context Menus --- */
QMenuBar {
    background-color: $bg_surface;
    border-bottom: 1px solid $border_subtle;
    padding: 3px 8px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 10px;
    border-radius: $radius_sm;
    color: $text_primary;
}

QMenuBar::item:selected {
    background-color: $bg_elevated;
}

QMenu {
    background-color: $bg_surface;
    border: 1px solid $border_strong;
    border-radius: $radius_md;
    padding: 5px;
}

QMenu::item {
    padding: 6px 26px 6px 12px;
    border-radius: $radius_sm;
}

QMenu::item:selected {
    background-color: $bg_selected;
    color: $accent_primary;
}

QMenu::item:disabled {
    color: $text_muted;
}

QMenu::separator {
    height: 1px;
    background-color: $border_subtle;
    margin: 5px 8px;
}

/* --- ToolBars & StatusBar --- */
QToolBar {
    background-color: $bg_surface;
    border-bottom: 1px solid $border_subtle;
    spacing: 4px;
    padding: 5px 10px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: $radius_sm;
    padding: 5px 9px;
    color: $text_primary;
}

QToolButton:hover {
    background-color: $bg_elevated;
    border-color: $border_subtle;
}

QToolButton:pressed, QToolButton:checked {
    background-color: $bg_selected;
    border-color: $accent_primary;
    color: $accent_primary;
}

QStatusBar {
    background-color: $bg_surface;
    border-top: 1px solid $border_subtle;
    color: $text_secondary;
    font-size: $font_size_sm;
    padding: 0px 6px;
}

QStatusBar::item {
    border: none;
}

/* --- Standard & Tactile Buttons --- */
QPushButton {
    background-color: $bg_surface;
    color: $text_primary;
    border: 1px solid $border_strong;
    border-radius: $radius_sm;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: $bg_elevated;
    border-color: $border_strong;
}

QPushButton:pressed {
    background-color: $bg_hover;
}

QPushButton:disabled {
    background-color: $bg_recessed;
    color: $text_muted;
    border-color: $border_subtle;
}

QPushButton[variant="primary"] {
    background-color: $accent_primary;
    color: $accent_text;
    border: 1px solid $accent_primary;
    font-weight: 600;
}

QPushButton[variant="primary"]:hover {
    background-color: $accent_hover;
    border-color: $accent_hover;
}

QPushButton[variant="primary"]:pressed {
    background-color: $accent_pressed;
    border-color: $accent_pressed;
}

QPushButton[variant="danger"] {
    background-color: $danger_bg;
    color: $danger;
    border: 1px solid $danger;
    font-weight: 500;
}

QPushButton[variant="danger"]:hover {
    background-color: $danger;
    color: $accent_text;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: $text_secondary;
}

QPushButton[variant="ghost"]:hover {
    background-color: $bg_elevated;
    color: $text_primary;
}

QPushButton[variant="segmented"] {
    background-color: $bg_elevated;
    border: 1px solid $border_subtle;
    color: $text_secondary;
    padding: 5px 12px;
}

QPushButton[variant="segmented"]:hover {
    background-color: $bg_hover;
    color: $text_primary;
}

QPushButton[variant="segmented"]:checked {
    background-color: $bg_surface;
    border: 1px solid $accent_primary;
    color: $accent_primary;
    font-weight: 600;
}

/* --- Hardware-Inspired Tactile Keycaps (Calculator / Keypad Controls) --- */
QPushButton[variant="key-num"] {
    background-color: $bg_surface;
    color: $text_primary;
    border: 1px solid $border_strong;
    border-radius: $radius_md;
    font-family: $font_mono;
    font-size: 16px;
    font-weight: 600;
    padding: 8px;
}

QPushButton[variant="key-num"]:hover {
    background-color: $bg_elevated;
}

QPushButton[variant="key-num"]:pressed {
    background-color: $bg_hover;
}

QPushButton[variant="key-op"] {
    background-color: $bg_elevated;
    color: $accent_primary;
    border: 1px solid $border_strong;
    border-radius: $radius_md;
    font-family: $font_mono;
    font-size: 15px;
    font-weight: 600;
    padding: 8px;
}

QPushButton[variant="key-op"]:hover {
    background-color: $bg_selected;
    border-color: $accent_primary;
}

QPushButton[variant="key-op"]:pressed {
    background-color: $accent_subtle;
}

QPushButton[variant="key-fn"] {
    background-color: $bg_recessed;
    color: $text_secondary;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
    font-family: $font_mono;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 8px;
}

QPushButton[variant="key-fn"]:hover {
    background-color: $bg_elevated;
    color: $text_primary;
    border-color: $border_strong;
}

QPushButton[variant="key-fn"]:pressed {
    background-color: $bg_hover;
}

QPushButton[variant="key-danger"] {
    background-color: $danger_bg;
    color: $danger;
    border: 1px solid $border_strong;
    border-radius: $radius_md;
    font-family: $font_mono;
    font-size: 14px;
    font-weight: 600;
    padding: 8px;
}

QPushButton[variant="key-danger"]:hover {
    background-color: $danger;
    color: $accent_text;
    border-color: $danger;
}

/* --- Text Inputs, Editors & Selectors --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
    background-color: $bg_surface;
    color: $text_primary;
    border: 1px solid $border_strong;
    border-radius: $radius_sm;
    padding: 6px 9px;
    selection-background-color: $accent_primary;
    selection-color: $accent_text;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus {
    border: 1px solid $accent_primary;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: $bg_recessed;
    color: $text_muted;
}

QComboBox {
    background-color: $bg_surface;
    color: $text_primary;
    border: 1px solid $border_strong;
    border-radius: $radius_sm;
    padding: 5px 10px;
}

QComboBox:hover {
    border-color: $accent_primary;
}

QComboBox QAbstractItemView {
    background-color: $bg_surface;
    border: 1px solid $border_strong;
    selection-background-color: $bg_selected;
    selection-color: $accent_primary;
    padding: 4px;
}

/* --- Checkboxes & Radio Buttons --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: $text_primary;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid $border_strong;
    background-color: $bg_surface;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: $accent_primary;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: $accent_primary;
    border-color: $accent_primary;
}

/* --- Tabs --- */
QTabWidget::pane {
    background-color: $bg_surface;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
    top: -1px;
}

QTabBar::tab {
    background-color: $bg_elevated;
    color: $text_secondary;
    border: 1px solid $border_subtle;
    padding: 7px 15px;
    margin-right: 3px;
    border-top-left-radius: $radius_sm;
    border-top-right-radius: $radius_sm;
}

QTabBar::tab:selected {
    background-color: $bg_surface;
    color: $accent_primary;
    font-weight: 600;
    border-bottom-color: $bg_surface;
}

QTabBar::tab:hover:!selected {
    background-color: $bg_hover;
    color: $text_primary;
}

/* --- Lists, Trees & Tables --- */
QListWidget, QTreeWidget, QTreeView, QTableView, QTableWidget {
    background-color: $bg_surface;
    alternate-background-color: $bg_canvas;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
    gridline-color: $border_subtle;
    selection-background-color: $bg_selected;
    selection-color: $text_primary;
}

QListWidget::item, QTreeWidget::item, QTreeView::item {
    padding: 6px 9px;
    border-radius: 3px;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: $bg_elevated;
}

QHeaderView::section {
    background-color: $bg_elevated;
    color: $text_secondary;
    font-weight: 600;
    border: none;
    border-right: 1px solid $border_subtle;
    border-bottom: 1px solid $border_subtle;
    padding: 6px 10px;
}

/* --- GroupBox, Splitter, Sliders & ProgressBar --- */
QGroupBox {
    background-color: $bg_surface;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
    margin-top: 14px;
    padding: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: $text_secondary;
}

QSplitter::handle {
    background-color: $border_subtle;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: $bg_elevated;
    border: 1px solid $border_subtle;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: $accent_primary;
    border: 1px solid $accent_primary;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QProgressBar {
    background-color: $bg_recessed;
    border: 1px solid $border_subtle;
    border-radius: $radius_sm;
    text-align: center;
    color: $text_primary;
    height: 18px;
}

QProgressBar::chunk {
    background-color: $accent_primary;
    border-radius: 4px;
}

/* --- ScrollBars --- */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: $scrollbar_thumb;
    border-radius: 5px;
    min-height: 28px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: $scrollbar_thumb_hover;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: $scrollbar_thumb;
    border-radius: 5px;
    min-width: 28px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: $scrollbar_thumb_hover;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0px;
    height: 0px;
}

/* --- ToolTips --- */
QToolTip {
    background-color: $bg_elevated;
    color: $text_primary;
    border: 1px solid $border_strong;
    padding: 5px 9px;
    border-radius: $radius_sm;
    font-size: $font_size_sm;
}