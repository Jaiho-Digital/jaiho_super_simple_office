/* ==========================================================================
   Jaiho Super Simple Office — Soft Modern Pastel Style Sheet
   Design DNA: Warm Neutral Foundations + Restrained Pastel Accents
   ========================================================================== */

* {
    font-family: $font_family;
    font-size: $font_size_base;
    color: $text_primary;
    outline: none;
}

QMainWindow, QDialog, QWidget#windowShell, QWidget#contentHost {
    background-color: $bg_canvas;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: $bg_canvas;
    border: none;
}

QWidget {
    background-color: transparent;
    color: $text_primary;
}

/* --- Typography Hierarchy --- */
QLabel[role="app-title"] {
    font-size: 15px;
    font-weight: 600;
    color: $text_primary;
    letter-spacing: -0.2px;
}

QLabel[role="title"] {
    font-size: $font_size_lg;
    font-weight: 600;
    color: $text_primary;
    letter-spacing: -0.3px;
}

QLabel[role="section-header"] {
    font-size: $font_size_md;
    font-weight: 600;
    color: $text_primary;
}

QLabel[role="muted"] {
    font-size: $font_size_sm;
    color: $text_secondary;
}

QLabel[role="caption"] {
    font-size: $font_size_xs;
    color: $text_muted;
}

QLabel[role="display-xl"] {
    font-family: $font_mono;
    font-size: 34px;
    font-weight: 600;
    color: $text_primary;
    letter-spacing: -0.6px;
}

QLabel[role="display-lg"] {
    font-family: $font_mono;
    font-size: $font_size_xl;
    font-weight: 600;
    color: $text_primary;
}

QLabel[code="true"] {
    font-family: $font_mono;
}

/* --- Surfaces, Cards & Integrated App Header --- */
QFrame[surface="app-header"] {
    background-color: $bg_surface;
    border-bottom: 1px solid $border_subtle;
}

QFrame[surface="footer-bar"] {
    background-color: $bg_surface;
    border-top: 1px solid $border_subtle;
}

QFrame[surface="card"] {
    background-color: $bg_surface;
    border: 1px solid $border_subtle;
    border-radius: $radius_lg;
}

QFrame[surface="page-sheet"] {
    background-color: $bg_surface;
    border: 1px solid $border_strong;
    border-radius: 6px;
}

QFrame[surface="elevated"] {
    background-color: $bg_elevated;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
}

QFrame[surface="recessed"] {
    background-color: $bg_recessed;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
}

QFrame[surface="pastel-well"] {
    background-color: $accent_subtle;
    border: 1px solid $accent_soft_border;
    border-radius: $radius_md;
}

QFrame[surface="sidebar"] {
    background-color: $bg_surface;
    border-right: 1px solid $border_subtle;
}

QFrame[surface="inspector"] {
    background-color: $bg_surface;
    border-left: 1px solid $border_subtle;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: $border_subtle;
}

/* --- Floating Context Menus --- */
QMenu {
    background-color: $bg_surface;
    border: 1px solid $border_strong;
    border-radius: $radius_md;
    padding: 6px;
}

QMenu::item {
    padding: 7px 22px 7px 12px;
    border-radius: 8px;
    color: $text_primary;
}

QMenu::item:selected {
    background-color: $bg_selected;
    color: $accent_primary;
}

QMenu::item:disabled {
    color: $text_muted;
}

QMenu::separator {
    height: 1px;
    background-color: $border_subtle;
    margin: 5px 8px;
}

/* --- Understated Rounded Buttons (10–12px Radii) --- */
QPushButton {
    background-color: $bg_surface;
    color: $text_primary;
    border: 1px solid $border_strong;
    border-radius: $radius_sm;
    padding: 7px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: $bg_hover;
    border-color: $accent_soft_border;
}

QPushButton:pressed {
    background-color: $bg_selected;
}

QPushButton:disabled {
    background-color: $bg_recessed;
    color: $text_muted;
    border-color: $border_subtle;
}

QPushButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 8px;
    width: 8px;
    height: 8px;
}

QPushButton[has_menu="true"] {
    padding-right: 22px;
}

QPushButton[variant="primary"] {
    background-color: $accent_primary;
    color: $accent_text;
    border: 1px solid $accent_primary;
    font-weight: 600;
}

QPushButton[variant="primary"]:hover {
    background-color: $accent_hover;
    border-color: $accent_hover;
}

QPushButton[variant="primary"]:pressed {
    background-color: $accent_pressed;
    border-color: $accent_pressed;
}

QPushButton[variant="pastel"] {
    background-color: $accent_subtle;
    color: $accent_primary;
    border: 1px solid $accent_soft_border;
    font-weight: 600;
}

QPushButton[variant="pastel"]:hover {
    background-color: $bg_hover;
    border-color: $accent_primary;
}

QPushButton[variant="danger"] {
    background-color: $danger_bg;
    color: $danger;
    border: 1px solid transparent;
    font-weight: 600;
}

QPushButton[variant="danger"]:hover {
    background-color: $danger;
    color: $accent_text;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: $text_secondary;
    padding: 6px 10px;
}

QPushButton[variant="ghost"]:hover {
    background-color: $bg_hover;
    color: $text_primary;
}

QPushButton[variant="segmented"] {
    background-color: $bg_elevated;
    border: 1px solid transparent;
    border-radius: 9px;
    color: $text_secondary;
    padding: 5px 12px;
    font-weight: 500;
}

QPushButton[variant="segmented"]:hover {
    background-color: $bg_hover;
    color: $text_primary;
}

QPushButton[variant="segmented"]:checked {
    background-color: $bg_surface;
    border: 1px solid $accent_soft_border;
    color: $accent_primary;
    font-weight: 600;
}

/* --- Soft Pastel Tactile Keycaps --- */
QPushButton[variant="key-num"] {
    background-color: $bg_surface;
    color: $text_primary;
    border: 1px solid $border_subtle;
    border-radius: 12px;
    font-family: $font_mono;
    font-size: 16px;
    font-weight: 600;
    padding: 8px;
}

QPushButton[variant="key-num"]:hover {
    background-color: $bg_hover;
    border-color: $border_strong;
}

QPushButton[variant="key-num"]:pressed {
    background-color: $bg_selected;
}

QPushButton[variant="key-op"] {
    background-color: $pastel_blue;
    color: $text_primary;
    border: 1px solid transparent;
    border-radius: 12px;
    font-family: $font_mono;
    font-size: 16px;
    font-weight: 600;
    padding: 8px;
}

QPushButton[variant="key-op"]:hover {
    background-color: $accent_subtle;
    color: $accent_primary;
    border-color: $accent_soft_border;
}

QPushButton[variant="key-op"]:pressed {
    background-color: $bg_selected;
}

QPushButton[variant="key-fn"] {
    background-color: $bg_elevated;
    color: $text_secondary;
    border: 1px solid transparent;
    border-radius: 11px;
    font-family: $font_mono;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 8px;
}

QPushButton[variant="key-fn"]:hover {
    background-color: $bg_hover;
    color: $text_primary;
    border-color: $border_subtle;
}

QPushButton[variant="key-fn"]:pressed {
    background-color: $bg_selected;
}

QPushButton[variant="key-danger"] {
    background-color: $pastel_blush;
    color: $danger;
    border: 1px solid transparent;
    border-radius: 12px;
    font-family: $font_mono;
    font-size: 14px;
    font-weight: 600;
    padding: 8px;
}

QPushButton[variant="key-danger"]:hover {
    background-color: $danger;
    color: $accent_text;
}

/* --- Inputs, Editors & Dropdowns --- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit {
    background-color: $bg_recessed;
    color: $text_primary;
    border: 1px solid $border_subtle;
    border-radius: $radius_sm;
    padding: 7px 11px;
    selection-background-color: $accent_primary;
    selection-color: $accent_text;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus {
    background-color: $bg_surface;
    border: 1px solid $accent_primary;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: $bg_recessed;
    color: $text_muted;
}

QComboBox {
    background-color: $bg_surface;
    color: $text_primary;
    border: 1px solid $border_strong;
    border-radius: $radius_sm;
    padding: 5px 10px;
}

QComboBox:hover {
    border-color: $accent_primary;
    background-color: $bg_hover;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: $bg_surface;
    border: 1px solid $border_strong;
    border-radius: $radius_sm;
    selection-background-color: $bg_selected;
    selection-color: $accent_primary;
    padding: 4px;
}

/* --- Checkboxes & Radio Buttons --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: $text_primary;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid $border_strong;
    background-color: $bg_surface;
}

QCheckBox::indicator {
    border-radius: 5px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: $accent_primary;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: $accent_primary;
    border-color: $accent_primary;
}

/* --- Tabs --- */
QTabWidget::pane {
    background-color: $bg_surface;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
    top: -1px;
}

QTabBar::tab {
    background-color: $bg_elevated;
    color: $text_secondary;
    border: 1px solid transparent;
    padding: 7px 16px;
    margin-right: 4px;
    border-top-left-radius: $radius_sm;
    border-top-right-radius: $radius_sm;
}

QTabBar::tab:selected {
    background-color: $bg_surface;
    color: $accent_primary;
    font-weight: 600;
    border: 1px solid $border_subtle;
    border-bottom-color: $bg_surface;
}

QTabBar::tab:hover:!selected {
    background-color: $bg_hover;
    color: $text_primary;
}

/* --- Lists, Trees & Tables --- */
QListWidget, QTreeWidget, QTreeView, QTableView, QTableWidget {
    background-color: $bg_surface;
    alternate-background-color: $bg_canvas;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
    gridline-color: $border_subtle;
    selection-background-color: $bg_selected;
    selection-color: $text_primary;
    padding: 4px;
}

QListWidget::item, QTreeWidget::item, QTreeView::item {
    padding: 7px 10px;
    border-radius: 8px;
    margin: 1px 0px;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: $bg_hover;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: $bg_selected;
    color: $accent_primary;
    font-weight: 500;
}

QHeaderView::section {
    background-color: $bg_elevated;
    color: $text_secondary;
    font-weight: 600;
    border: none;
    border-right: 1px solid $border_subtle;
    border-bottom: 1px solid $border_subtle;
    padding: 7px 10px;
}

/* --- GroupBox, Splitter, Sliders & ProgressBar --- */
QGroupBox {
    background-color: $bg_surface;
    border: 1px solid $border_subtle;
    border-radius: $radius_md;
    margin-top: 14px;
    padding: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: $text_secondary;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:vertical {
    height: 6px;
}

QSlider::groove:horizontal {
    height: 5px;
    background-color: $bg_elevated;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: $accent_primary;
    width: 15px;
    height: 15px;
    margin: -5px 0;
    border-radius: 8px;
}

QProgressBar {
    background-color: $bg_recessed;
    border: 1px solid $border_subtle;
    border-radius: 8px;
    text-align: center;
    color: $text_primary;
    height: 16px;
    font-size: $font_size_xs;
}

QProgressBar::chunk {
    background-color: $accent_primary;
    border-radius: 7px;
}

/* --- Thin, Minimal ScrollBars --- */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 2px 0px;
}

QScrollBar::handle:vertical {
    background-color: $scrollbar_thumb;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: $scrollbar_thumb_hover;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0px 2px;
}

QScrollBar::handle:horizontal {
    background-color: $scrollbar_thumb;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: $scrollbar_thumb_hover;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0px;
    height: 0px;
}

/* --- Small, Elegant ToolTips --- */
QToolTip {
    background-color: $bg_surface;
    color: $text_primary;
    border: 1px solid $border_strong;
    padding: 5px 10px;
    border-radius: 8px;
    font-size: $font_size_xs;
}